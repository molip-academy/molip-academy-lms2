variable "app_1_db_name" {
  description = "app_1 db_name"
  default     = "" // postgresql 데이터베이스 이름, 예: molip
}

variable "app_1_db_user" {
  description = "app_1 db_user"
  default     = "" // postgresql 사용자 이름, 예: molip
}

variable "password_1" {
  description = "password_1"
  default     = "" // postgresql 비밀번호, 공개되면 안됨. openssl rand -base64 24
}

variable "jwt_secret_1" {
  description = "jwt_secret_1"
  default     = "" // JWT 서명 키, 공개되면 안됨. 바꾸면 기존 로그인 세션이 전부 무효가 된다. openssl rand -base64 48
}

variable "acme_email_1" {
  description = "acme_email_1"
  default     = "" // Let's Encrypt 인증서 만료 알림을 받을 이메일

}

variable "github_owner_1" {
  description = "github_owner_1"
  default     = "" // GITHUB 계정/조직 소문자(이메일 아님), 예: molip-academy
}

variable "github_token_1" {
  description = "github_token_1, read:packages only"
  default     = "" // GITHUB classic token(read:packages 만, 만료 90일 이하). VM 이 ghcr 에서 이미지를 당길 때 쓴다.
}
